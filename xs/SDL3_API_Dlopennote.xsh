MODULE = SDL3  PACKAGE = SDL3::API::Dlopennote

BOOT:
	{
	HV *stash = gv_stashpv("SDL3::API::Dlopennote", GV_ADD);
	bg_export_constant(aTHX_ stash, "SDL_ELF_NOTE_DLOPEN_PRIORITY_RECOMMENDED", BG_CONST_SV(SDL_ELF_NOTE_DLOPEN_PRIORITY_RECOMMENDED));
	bg_export_constant(aTHX_ stash, "SDL_ELF_NOTE_DLOPEN_PRIORITY_REQUIRED", BG_CONST_SV(SDL_ELF_NOTE_DLOPEN_PRIORITY_REQUIRED));
	bg_export_constant(aTHX_ stash, "SDL_ELF_NOTE_DLOPEN_PRIORITY_SUGGESTED", BG_CONST_SV(SDL_ELF_NOTE_DLOPEN_PRIORITY_SUGGESTED));
	bg_export_constant(aTHX_ stash, "SDL_ELF_NOTE_DLOPEN_TYPE", BG_CONST_SV(SDL_ELF_NOTE_DLOPEN_TYPE));
	bg_export_constant(aTHX_ stash, "SDL_ELF_NOTE_DLOPEN_VENDOR", BG_CONST_SV(SDL_ELF_NOTE_DLOPEN_VENDOR));
	}
