MODULE = SDL3  PACKAGE = SDL3::API::Hints

void
SDL_SetHintWithPriority(sv_name, sv_value, sv_priority)
	SV *sv_name
	SV *sv_value
	SV *sv_priority
    PREINIT:
	const char * c_name;
	const char * c_value;
	SDL_HintPriority c_priority;
	_Bool c_bg_ret;
    PPCODE:
	c_name = (const char *)bg_in_string(aTHX_ sv_name, "SDL_SetHintWithPriority(name)");
	c_value = (const char *)bg_in_string(aTHX_ sv_value, "SDL_SetHintWithPriority(value)");
	c_priority = (SDL_HintPriority)bg_in_iv(aTHX_ sv_priority, "SDL_SetHintWithPriority(priority)");
	c_bg_ret = SDL_SetHintWithPriority(c_name, c_value, c_priority);
	ST(0) = sv_2mortal(newSVsv(boolSV(c_bg_ret)));
	XSRETURN(1);

void
SDL_SetHint(sv_name, sv_value)
	SV *sv_name
	SV *sv_value
    PREINIT:
	const char * c_name;
	const char * c_value;
	_Bool c_bg_ret;
    PPCODE:
	c_name = (const char *)bg_in_string(aTHX_ sv_name, "SDL_SetHint(name)");
	c_value = (const char *)bg_in_string(aTHX_ sv_value, "SDL_SetHint(value)");
	c_bg_ret = SDL_SetHint(c_name, c_value);
	ST(0) = sv_2mortal(newSVsv(boolSV(c_bg_ret)));
	XSRETURN(1);

void
SDL_ResetHint(sv_name)
	SV *sv_name
    PREINIT:
	const char * c_name;
	_Bool c_bg_ret;
    PPCODE:
	c_name = (const char *)bg_in_string(aTHX_ sv_name, "SDL_ResetHint(name)");
	c_bg_ret = SDL_ResetHint(c_name);
	ST(0) = sv_2mortal(newSVsv(boolSV(c_bg_ret)));
	XSRETURN(1);

void
SDL_ResetHints()
    PPCODE:
	SDL_ResetHints();
	XSRETURN(0);

void
SDL_GetHint(sv_name)
	SV *sv_name
    PREINIT:
	const char * c_name;
	const char * c_bg_ret;
    PPCODE:
	c_name = (const char *)bg_in_string(aTHX_ sv_name, "SDL_GetHint(name)");
	c_bg_ret = SDL_GetHint(c_name);
	ST(0) = sv_2mortal(bg_out_string(aTHX_ (const char *)(c_bg_ret)));
	XSRETURN(1);

void
SDL_GetHintBoolean(sv_name, sv_default_value)
	SV *sv_name
	SV *sv_default_value
    PREINIT:
	const char * c_name;
	_Bool c_default_value;
	_Bool c_bg_ret;
    PPCODE:
	c_name = (const char *)bg_in_string(aTHX_ sv_name, "SDL_GetHintBoolean(name)");
	c_default_value = (_Bool)SvTRUE(sv_default_value);
	c_bg_ret = SDL_GetHintBoolean(c_name, c_default_value);
	ST(0) = sv_2mortal(newSVsv(boolSV(c_bg_ret)));
	XSRETURN(1);

void
SDL_AddHintCallback(sv_name, sv_callback, sv_userdata)
	SV *sv_name
	SV *sv_callback
	SV *sv_userdata
    PREINIT:
	const char * c_name;
	SDL_HintCallback c_callback;
	void * c_userdata;
	_Bool c_bg_ret;
    PPCODE:
	c_name = (const char *)bg_in_string(aTHX_ sv_name, "SDL_AddHintCallback(name)");
	c_callback = SvOK(sv_callback) ? (SDL_HintCallback)bg_tramp_SDL_HintCallback : NULL;
	c_userdata = SvOK(sv_callback) ? (void *)bg_make_holder(aTHX_ sv_callback, sv_userdata, "SDL_AddHintCallback(userdata)") : NULL;
	c_bg_ret = SDL_AddHintCallback(c_name, c_callback, c_userdata);
	ST(0) = sv_2mortal(newSVsv(boolSV(c_bg_ret)));
	XSRETURN(1);

void
SDL_RemoveHintCallback(sv_name, sv_callback, sv_userdata)
	SV *sv_name
	SV *sv_callback
	SV *sv_userdata
    PREINIT:
	const char * c_name;
	SDL_HintCallback c_callback;
	void * c_userdata;
    PPCODE:
	c_name = (const char *)bg_in_string(aTHX_ sv_name, "SDL_RemoveHintCallback(name)");
	c_callback = SvOK(sv_callback) ? (SDL_HintCallback)bg_tramp_SDL_HintCallback : NULL;
	c_userdata = SvOK(sv_callback) ? (void *)bg_make_holder(aTHX_ sv_callback, sv_userdata, "SDL_RemoveHintCallback(userdata)") : NULL;
	SDL_RemoveHintCallback(c_name, c_callback, c_userdata);
	XSRETURN(0);

